# FirstRead environment variables.
# Copy to `.env` (gitignored) with `make setup` or `cp .env.example .env`.
# Values below are for the LOCAL Docker stack only. Never put real secrets in this file.

# ---- API (services/api, read by pydantic-settings) ----
# local | test | prod
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Postgres DSN. Inside Docker Compose the API overrides the host to `db`.
DATABASE_URL=postgresql://firstread:firstread@localhost:5432/firstread
# Redis URL. Inside Docker Compose the API overrides the host to `redis`.
REDIS_URL=redis://localhost:6379/0
# Per-dependency timeout for /readyz, in seconds.
READYZ_TIMEOUT_S=2.0

# ---- Ingestion (services/ingest, Phase 2; also reads DATABASE_URL / REDIS_URL above) ----
# Model release with the topic classifier; pinned by manifest SHA256 in firstread_ingest/models.py.
INGEST_MODEL_TAG=v0.2.0
# Optional: a local folder holding that release (e.g. data/release/v0.2.0 before upload).
# It is verified against the same pin. Leave empty to download from the Hugging Face Hub.
INGEST_MODEL_DIR=
# Feeds fetched concurrently (feeds on the same host always go one at a time).
INGEST_RSS_CONCURRENCY=8
# Near-duplicate / same-story cosine thresholds (ADR 0009). These are the fallbacks;
# validated per-pair-type values (GDELT/RSS) live in firstread_ingest/dedupe.py.
INGEST_TAU_DUP=0.975
INGEST_TAU_STORY=0.875
INGEST_PER_PAIR_THRESHOLDS=true
# Dedupe looks back this far for similar stories, and this far for identical headlines.
INGEST_DEDUPE_WINDOW_HOURS=48
INGEST_FINGERPRINT_WINDOW_HOURS=72
# Headlines with fewer words are dropped ("Earthquake hits Japan" has 3).
INGEST_MIN_TITLE_WORDS=3

# ---- Local Docker stack (infra/docker/docker-compose.yml) ----
POSTGRES_USER=firstread
POSTGRES_PASSWORD=firstread
POSTGRES_DB=firstread
# Host ports (change if they clash with something already running).
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# ---- Model release (ml, Phase 1c; local only, never needed in CI) ----
# Hugging Face *write* token for `make release-upload` (huggingface.co/settings/tokens).
# Leave empty unless you are publishing a model release. Never commit a real value.
HF_TOKEN=
