# FirstRead environment variables.
# Copy to `.env` (gitignored) with `make setup` or `cp .env.example .env`.
# Values below are for the LOCAL Docker stack only. Never put real secrets in this file.

# ---- API (services/api, read by pydantic-settings) ----
# local | test | prod
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Postgres DSN. Inside Docker Compose the API overrides the host to `db`.
DATABASE_URL=postgresql://firstread:firstread@localhost:5432/firstread
# Redis URL. Inside Docker Compose the API overrides the host to `redis`.
REDIS_URL=redis://localhost:6379/0
# Per-dependency timeout for /readyz, in seconds.
READYZ_TIMEOUT_S=2.0
# Max connections in the API's asyncpg pool (Supabase Free: 200 pooler clients).
DB_POOL_MAX=5
# Every response carries model_version = "<API_MODEL_TAG>+<API_RANKING_VERSION>" (ADR 0014).
API_MODEL_TAG=v0.2.0
API_RANKING_VERSION=rank-2

# ---- API feed (ADR 0017) ----
# The verified release folder baked into the image (/app/models/v0.2.0). Empty locally:
# the pinned release is downloaded into ~/.cache/firstread/models. Required in prod.
API_MODEL_DIR=
API_LOAD_MODEL=true
# ONNX Runtime threads (Cloud Run gives 1 vCPU) and micro-batching across requests.
API_ONNX_THREADS=1
API_ENCODER_BATCHING=true
API_BATCH_MAX=32
API_BATCH_WAIT_MS=5
# exact or hnsw: chosen by the benchmark in docs/learn/data/03-ann.json.
API_ANN_MODE=exact
API_ANN_EF_SEARCH=200
# Cached user vectors, pool-version checks, article LRU size, page cache (seconds/rows).
API_VEC_TTL_S=600
API_POOLS_CHECK_S=60
API_ARTICLE_CACHE=20000
API_PAGE_CACHE_S=60
# Deadlines (seconds): the whole feed request, then each stage. Past a stage deadline
# the feed degrades (Redis, encoder, ANN) or answers 503 (hydrate, persist).
API_FEED_TIMEOUT_S=1.0
API_STATE_TIMEOUT_S=0.03
API_ENCODE_TIMEOUT_S=0.03
API_CANDIDATES_TIMEOUT_S=0.08
API_HYDRATE_TIMEOUT_S=0.06
API_PERSIST_TIMEOUT_S=0.05

# ---- API auth (ADR 0015): Supabase JWTs verified against the project's JWKS ----
# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json (P5). Required in prod.
AUTH_JWKS_URL=
# https://<project-ref>.supabase.co/auth/v1 (the tokens' `iss`). Required in prod.
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
# Comma-separated allowlist. ES256 (Supabase's asymmetric keys); RS256 only on purpose.
# HS256 and "none" are always refused.
AUTH_ALGORITHMS=ES256
# JWKS cache lifetime (at most 600 s) and the minimum gap between refetches for an
# unknown key id (key rotation).
AUTH_JWKS_TTL_S=600
AUTH_JWKS_MIN_REFRESH_S=60
AUTH_LEEWAY_S=30
# Timeout for fetching the JWKS, in seconds.
AUTH_HTTP_TIMEOUT_S=2.0
# After a failed JWKS fetch with an expired cache, answer 503 at once for this long
# (seconds) instead of every request waiting on another fetch.
AUTH_JWKS_FAILURE_BACKOFF_S=10
# LOCAL/TEST ONLY (prod refuses to start with either): accept `X-Dev-User: <uuid>`
# without a token, and/or read the JWKS from a file (the load test signs its own tokens).
AUTH_DEV_BYPASS=false
AUTH_LOCAL_JWKS_FILE=

# ---- API HTTP ----
# Comma-separated CORS origins: GitHub Pages and the Expo dev servers.
API_CORS_ORIGINS=https://unmesh30.github.io,http://localhost:8081,http://localhost:19006
# In-process rate limits per instance (requests per minute; ADR 0015).
RL_USER_FEED_PER_MIN=60
RL_USER_EVENTS_PER_MIN=120
RL_USER_WRITES_PER_MIN=10
RL_IP_PER_MIN=300
# Keys each limiter remembers before forgetting the least recently used.
RL_MAX_KEYS=10000
# Bearer token for /metrics outside local. Required in prod; never commit a real value.
METRICS_TOKEN=
# HMAC key for hashed user ids in logs. Must be a secret in prod; this default is local-only.
LOG_UID_SALT=local-dev-salt-not-secret

# ---- Ingestion (services/ingest, Phase 2; also reads DATABASE_URL / REDIS_URL above) ----
# Model release with the topic classifier; pinned by manifest SHA256 in firstread_ingest/models.py.
INGEST_MODEL_TAG=v0.2.0
# Optional: a local folder holding that release (e.g. data/release/v0.2.0 before upload).
# It is verified against the same pin. Leave empty to download from the Hugging Face Hub.
INGEST_MODEL_DIR=
# Feeds fetched concurrently (feeds on the same host always go one at a time).
INGEST_RSS_CONCURRENCY=8
# Near-duplicate / same-story cosine thresholds (ADR 0009). These are the fallbacks;
# validated per-pair-type values (GDELT/RSS) live in firstread_ingest/dedupe.py.
INGEST_TAU_DUP=0.975
INGEST_TAU_STORY=0.925
INGEST_PER_PAIR_THRESHOLDS=true
# Dedupe looks back this far for similar stories, and this far for identical headlines.
INGEST_DEDUPE_WINDOW_HOURS=48
INGEST_FINGERPRINT_WINDOW_HOURS=72
# Headlines with fewer words are dropped ("Earthquake hits Japan" has 3).
INGEST_MIN_TITLE_WORDS=3
# GDELT files caught up per run (2 h), when the newest file counts as stale, and how many
# new GKG candidates are embedded per run (CPU bound).
INGEST_GKG_MAX_FILES=8
INGEST_GKG_STALE_MINUTES=60
INGEST_GKG_MAX_EMBED=2000
# GDELT per-run selection (ADR 0007): cap per run, per outlet, per story (feed shows <= 2).
INGEST_GKG_MAX_PER_RUN=50
INGEST_GKG_MAX_PER_DOMAIN=3
INGEST_GKG_MAX_PER_STORY=3
INGEST_GKG_TOPIC_MIN=2
# Retention (ADR 0008): articles 14 days, story coverage 48 h (trending uses 24 h).
INGEST_RETENTION_ARTICLE_DAYS=14
INGEST_RETENTION_COVERAGE_HOURS=48
INGEST_RETENTION_RUNS_DAYS=30
# The run summary warns above this database size (the size guard starts here too).
INGEST_SIZE_WARN_MB=350
# User data (ADR 0016). Above 350/375/400 MB the size guard shortens these on its own.
INGEST_RETENTION_IMPRESSIONS_DAYS=7
INGEST_RETENTION_EVENTS_DAYS=30
INGEST_RETENTION_SLATES_DAYS=30
INGEST_RETENTION_INACTIVE_ANONYMOUS_DAYS=30
# Runner-side copy of the last 72 h of articles (ADR 0012). It's only a cache: a missing
# or mismatched file means a full reload (~14 MB of Supabase egress). Empty: no file, so
# every run reloads. GitHub Actions sets this to a cached path.
INGEST_WINDOW_FILE=

# ---- Local Docker stack (infra/docker/docker-compose.yml) ----
POSTGRES_USER=firstread
POSTGRES_PASSWORD=firstread
POSTGRES_DB=firstread
# Host ports (change if they clash with something already running).
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# ---- Model release (ml, Phase 1c; local only, never needed in CI) ----
# Hugging Face *write* token for `make release-upload` (huggingface.co/settings/tokens).
# Leave empty unless you are publishing a model release. Never commit a real value.
HF_TOKEN=
