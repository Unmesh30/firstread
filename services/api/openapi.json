          "text"
        ],
        "title": "ReasonOut",
        "type": "object"
      },
      "RejectedEvent": {
        "properties": {
          "code": {
            "const": "unknown_article",
            "title": "Code",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "code"
        ],
        "title": "RejectedEvent",
        "type": "object"
      },
      "Topic": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
