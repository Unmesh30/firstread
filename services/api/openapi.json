{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventIn": {
        "properties": {
          "article_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Article Id"
          },
          "client_ts": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Ts"
          },
          "dwell_ms": {
            "anyOf": [
              {
                "maximum": 3600000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dwell Ms"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "maximum": 999.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "request_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "scope": {
            "anyOf": [
              {
                "enum": [
                  "article",
                  "source"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope"
          },
          "type": {
            "enum": [
              "impression",
              "click",
              "like",
              "hide",
              "dwell"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "type"
        ],
        "title": "EventIn",
        "type": "object"
      },
      "EventsBatch": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventIn"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "EventsBatch",
        "type": "object"
      },
      "EventsResult": {
        "properties": {
          "accepted": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Accepted",
            "type": "array"
          },
          "duplicate": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Duplicate",
            "type": "array"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "rejected": {
            "items": {
              "$ref": "#/components/schemas/RejectedEvent"
            },
            "title": "Rejected",
            "type": "array"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "model_version",
          "accepted",
          "duplicate",
          "rejected"
        ],
        "title": "EventsResult",
        "type": "object"
      },
      "FeedItem": {
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "first_seen_at": {
            "format": "date-time",
            "title": "First Seen At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/ReasonOut"
            },
            "title": "Reasons",
            "type": "array"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "source_domain": {
            "title": "Source Domain",
            "type": "string"
          },
          "source_name": {
            "title": "Source Name",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "source_name",
          "source_domain",
          "url",
          "image_url",
          "category",
          "published_at",
          "first_seen_at",
          "score",
          "reasons"
        ],
        "title": "FeedItem",
        "type": "object"
      },
      "FeedResponse": {
        "properties": {
          "degraded": {
            "items": {
              "type": "string"
            },
            "title": "Degraded",
            "type": "array"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/FeedItem"
            },
            "title": "Items",
            "type": "array"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "model_version",
          "items",
          "next_cursor",
          "degraded"
        ],
        "title": "FeedResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "HistoryItem": {
        "properties": {
          "article_id": {
            "format": "uuid",
            "title": "Article Id",
            "type": "string"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "clicked_at": {
            "format": "date-time",
            "title": "Clicked At",
            "type": "string"
          },
          "source_name": {
            "title": "Source Name",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "article_id",
          "title",
          "source_name",
          "category",
          "clicked_at"
        ],
        "title": "HistoryItem",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "active_persona": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Persona"
          },
          "hidden_sources": {
            "items": {
              "type": "string"
            },
            "title": "Hidden Sources",
            "type": "array"
          },
          "history_count": {
            "title": "History Count",
            "type": "integer"
          },
          "is_anonymous": {
            "title": "Is Anonymous",
            "type": "boolean"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "recent_history": {
            "items": {
              "$ref": "#/components/schemas/HistoryItem"
            },
            "title": "Recent History",
            "type": "array"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "title": "Topics",
            "type": "array"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "model_version",
          "user_id",
          "is_anonymous",
          "topics",
          "hidden_sources",
          "active_persona",
          "history_count",
          "recent_history"
