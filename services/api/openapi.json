        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "error",
                "timeout"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "model_tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Tag"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ReasonOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "text": {
